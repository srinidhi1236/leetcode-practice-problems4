class Solution:
    def minCost(self, nums, x):
        n = len(nums)
        best = nums[:]
        ans = sum(best)

        for k in range(1, n):
            for i in range(n):
                best[i] = min(best[i], nums[(i + k) % n])

            ans = min(ans, sum(best) + k * x)

        return ans
        
